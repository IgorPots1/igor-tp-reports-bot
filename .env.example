SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
ADMIN_ACCESS_TOKEN=change-me
APP_BASE_URL=
NEXT_PUBLIC_APP_URL=
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_USERNAME=
TELEGRAM_COACH_CHAT_IDS=507447935
TRAININGPEAKS_GROUP_PROBE_ENABLED=
TRAININGPEAKS_CONTEXT_OBSERVER_ENABLED=
TRAININGPEAKS_API_BEARER=
TRAININGPEAKS_GROUP_WORKOUT_REPORT_INTAKE_ENABLED=
TRAININGPEAKS_GROUP_WORKOUT_REPORT_CHAT_ALLOWLIST=
TRAININGPEAKS_GROUP_WORKOUT_REPORT_REVIEW_ENABLED=
TRAININGPEAKS_GROUP_WORKOUT_REPORT_GENERATE_ENABLED=
TRAININGPEAKS_GROUP_WORKOUT_REPORT_SEND_ENABLED=
TRAININGPEAKS_INTENT_AI_MODE=
OPENAI_API_KEY=
OPENAI_MOVE_WORKOUT_PARSER_MODEL=
OPENAI_REPLY_DRAFT_MODEL=
# Пауза (мс) между запросами к модели при генерации разборов питания. Дефолт 1800.
NUTRITION_GEN_DELAY_MS=
# Провайдер модели для nutrition-прозы: openai | anthropic. Дефолт anthropic.
NUTRITION_AI_PROVIDER=
# Модель для nutrition-прозы. Дефолт под провайдера: anthropic -> claude-sonnet-4-6, openai -> gpt-4o-mini.
NUTRITION_AI_MODEL=
# Ключ Anthropic (нужен, когда NUTRITION_AI_PROVIDER=anthropic).
ANTHROPIC_API_KEY=
COACH_MEMORY_EXTRACTION_ENABLED=
COACH_MEMORY_EXTRACTION_MODEL=
COACH_MEMORY_MIN_CONFIDENCE=
COACH_MEMORY_WRITE_LIMIT_PER_RUN=
TP_MOVE_DATE_BASE_DATE=
# --- Локальный mac-раннер переносов (launchd) ---
# ВНИМАНИЕ: обе переменные ниже задаются в launchd-плисте
# (tools/trainingpeaks-export/scripts/install-tp-actions-launchagent.sh), и плист ПОБЕЖДАЕТ
# этот файл — загрузчик .env не перезаписывает уже заданные переменные окружения.
# Здесь они перечислены как документация и для ручных прогонов tp-actions-once.
#
# Чем исполняется перенос: live_primary (по HTTP, без браузера) | shadow (старый DOM-путь) | off.
# Не задано ИЛИ опечатка → откат на shadow. Раньше это происходило молча; теперь раннер об этом
# кричит в лог, а луп при старте службы шлёт алерт в Telegram.
TP_MOVE_RESOLVER_MODE=live_primary
# Read-only компаратор: на каждом реальном переносе сверяет HTTP-резолвер с DOM-эталоном и пишет
# строку в trainingpeaks_move_shadow_comparisons. На исполнение не влияет никогда.
TP_MOVE_SHADOW_ENABLED=true
TELEGRAM_BUSINESS_CONNECTION_ID=
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_here
CRON_SECRET=your_cron_secret_here
LEADS_CHAT_ID=
