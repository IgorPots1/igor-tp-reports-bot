node_modules
.next
.next-admin*
out
# Next.js переписывает эту ссылку под текущий distDir на каждом next dev/build
# (./.next/types/routes.d.ts меняется на ./.next-admin/types/routes.d.ts и обратно).
# Локальная админка и Vercel собираются в разные distDir из одной WorkingDirectory,
# поэтому файл не может стабильно лежать в гите — Next пересоздаёт его сам всегда.
next-env.d.ts
coverage
.env
.env.local
.env.*.local
.env.local.empty-*
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.vercel
.cursor/debug-*.log
tools/trainingpeaks-export/logs/
.env.vercel.production
reports/strength-builder-create-test-workout/

# graphify (knowledge graph) — locally rebuilt per-worktree, never committed.
# Covers GRAPH_REPORT.md, graph.json, .graphify_analysis.json, manifest.json, cache/.
graphify-out/
.graphify/

# .graphifyignore is NOT listed here — it's a security control (excludes
# student-data directories from the graph) and must be tracked + carried
# across every worktree, not left to be recreated by hand each time.
.playwright-mcp/

# accidental-add guard: root-level student working materials and stray backups
.DS_Store
*.bak
reports/
outputs-analysis/
ЧЕКПОЙНТ_*

# probeg recon response cache (local, not committed)
probeg-cache/

# Кэш страниц конвейера сбора базы кроссовок: сотни мегабайт чужого HTML.
# В репозиторий не идёт, пересобирается запуском collect.ts.
tools/shoes-pipeline/.cache/

# Служебное от Supabase CLI: ссылка на подключённый проект и метка версии.
# Машинное, локальное, у каждого своё — в гит не идёт [24.09.2026].
supabase/.temp/

# Личные разрешения Claude Code на ЭТОЙ машине: файл дописывается почти каждую
# сессию. Если его коммитить, `git status` в каноническом каталоге перестаёт
# быть чистым навсегда — а именно на это ругается localadmin-rebuild.sh.
# Общая часть настроек лежит рядом в settings.json и в гите [24.09.2026].
.claude/settings.local.json
