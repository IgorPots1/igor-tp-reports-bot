<?xml version="1.0" encoding="UTF-8"?>
<!-- Непрерывный пересчёт структур (Режим A, READ-ONLY к TP). Каждую ночь в 04:10 проверяет
     плановые тренировки на дрейф порога/описания vs stored %, пишет в tp_structure_recompute_*
     и шлёт утреннюю сводку с командой применения. В TP САМ НЕ ПИШЕТ — тренер применяет вручную.
     Установка: cp в ~/Library/LaunchAgents/, chmod +x run-structure-recompute-nightly.sh,
     launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.igor.trainingpeaks.structure-recompute-nightly.plist -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.igor.trainingpeaks.structure-recompute-nightly</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>"$HOME/igor-tp-reports-bot/tools/trainingpeaks-export/scripts/run-structure-recompute-nightly.sh"</string>
  </array>

  <!-- каждую ночь в 04:10; пропущенное во сне launchd докрутит на пробуждении -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>4</integer>
    <key>Minute</key>
    <integer>10</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/igor/igor-tp-reports-bot/tools/trainingpeaks-export/logs/structure-recompute-nightly.launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/igor/igor-tp-reports-bot/tools/trainingpeaks-export/logs/structure-recompute-nightly.launchd.err.log</string>
</dict>
</plist>
