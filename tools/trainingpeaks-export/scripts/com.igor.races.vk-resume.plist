<?xml version="1.0" encoding="UTF-8"?>
<!-- Продолжение обхода ВК по точкам /races после лимита ВК — раз в день в 12:40.
     Если незаконченного круга нет (~/ops-log/races/vk-sweep.json, done_at), сразу выходит.
     В базу не пишет: кандидатов проверяет агент еженедельного раннера (com.igor.races.weekly).
     НЕ ставится автоматически. Ставит Игорь:
       cp .../com.igor.races.vk-resume.plist ~/Library/LaunchAgents/
       launchctl load ~/Library/LaunchAgents/com.igor.races.vk-resume.plist -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.igor.races.vk-resume</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>"$HOME/igor-tp-reports-bot/tools/trainingpeaks-export/scripts/run-races-vk-resume.sh"</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>12</integer>
    <key>Minute</key><integer>40</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/igor/igor-tp-reports-bot/tools/trainingpeaks-export/logs/races-vk-resume.launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/igor/igor-tp-reports-bot/tools/trainingpeaks-export/logs/races-vk-resume.launchd.err.log</string>
</dict>
</plist>
