<?xml version="1.0" encoding="UTF-8"?>
<!-- Быстрый скан КАЖДЫЕ 30 МИН (на :00 и :30), окно [-10 … +10]. Кладётся в ~/Library/LaunchAgents/.
     Учащение безопасно: скан ушёл с браузерного профиля на fetch-клиент (ЭТАП 2), лока профиля
     больше нет, с move/races-лупами не дерётся, полный обход ~26с на 118 учеников. Сутки на 60 мин
     прошли без сбоев по частоте → перевод на 30 мин. fit-ingest идёт следом на :05/:35. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.igor.trainingpeaks.workout-cache-scan</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>PAST_DAYS=10 FUTURE_DAYS=10 "$HOME/igor-tp-reports-bot/tools/trainingpeaks-export/scripts/run-workout-cache-scan.sh"</string>
  </array>

  <!-- запуск при каждом входе/включении ноута (ловит правки, накопившиеся пока Mac был выключен) -->
  <key>RunAtLoad</key>
  <true/>

  <!-- КАЖДЫЕ 30 МИН на :00 и :30 (массив интервалов; Minute без Hour = каждый час на эту минуту).
       Полный обход ~26с на новом fetch-пути. Пропущенные во сне прогоны launchd докручивает при пробуждении. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Minute</key><integer>0</integer></dict>
    <dict><key>Minute</key><integer>30</integer></dict>
  </array>

  <key>StandardOutPath</key>
  <string>/Users/igor/igor-tp-reports-bot/tools/trainingpeaks-export/logs/workout-cache-scan.launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/igor/igor-tp-reports-bot/tools/trainingpeaks-export/logs/workout-cache-scan.launchd.err.log</string>
</dict>
</plist>
