<?xml version="1.0" encoding="UTF-8"?>
<!-- Auto-drain approved club_calendar_entries into TrainingPeaks every 5 min (StartInterval 300s),
     so a student's start / day-off reaches TP within ~5 min instead of up to 30. Safe to run often:
     an idle run is just a DB query — club-execute-approved-once.ts logs into TP ONLY when the
     approved queue is non-empty, so TP-login frequency is bounded by real submissions, not poll rate.
     Executes ONLY when CLUB_TP_EXECUTION_ENABLED=true (set in ~/.bash_profile, read via bash -lc).
     Flag off → the runner dry-runs, writes nothing.
     Install by Igor AFTER a manual dry-run review:
       cp .../com.igor.trainingpeaks.club-execute-approved.plist ~/Library/LaunchAgents/
       launchctl load ~/Library/LaunchAgents/com.igor.trainingpeaks.club-execute-approved.plist -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.igor.trainingpeaks.club-execute-approved</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>"$HOME/igor-tp-reports-bot/tools/trainingpeaks-export/scripts/run-club-execute-approved.sh"</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>StartInterval</key>
  <integer>300</integer>

  <key>StandardOutPath</key>
  <string>/Users/igor/igor-tp-reports-bot/tools/trainingpeaks-export/logs/club-execute-approved.launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/igor/igor-tp-reports-bot/tools/trainingpeaks-export/logs/club-execute-approved.launchd.err.log</string>
</dict>
</plist>
