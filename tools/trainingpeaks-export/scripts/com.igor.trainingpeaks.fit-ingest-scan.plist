<?xml version="1.0" encoding="UTF-8"?>
<!-- FIT-ingest scan + feedback-enqueue — считает derived_metrics ИЗ скачанного кэша
     и СРАЗУ САМ кладёт новые тренировки в «Новые» (enqueue на маке, ноль кронов Vercel).
     Идёт СЛЕДОМ за workout-cache-scan (КАЖДЫЙ ЧАС на :05, cache-scan на :00 — новому
     fetch-пути хватает ~26с). Окно последних 5 дней. Кладётся в ~/Library/LaunchAgents/. Ставит Игорь:
       cp .../com.igor.trainingpeaks.fit-ingest-scan.plist ~/Library/LaunchAgents/
       launchctl load ~/Library/LaunchAgents/com.igor.trainingpeaks.fit-ingest-scan.plist -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.igor.trainingpeaks.fit-ingest-scan</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>PAST_DAYS=5 "$HOME/igor-tp-reports-bot/tools/trainingpeaks-export/scripts/run-fit-ingest-scan.sh"</string>
  </array>

  <!-- запуск при каждом входе/включении ноута (добирает пропущенное за время сна) -->
  <key>RunAtLoad</key>
  <true/>

  <!-- КАЖДЫЙ ЧАС на :05 — на 5 мин ПОЗЖЕ cache-scan (:00), чтобы тренировки уже были в
       кэше, когда считаем из них метрики (Minute без Hour = каждый час).
       Пропущенные во сне прогоны launchd докручивает при пробуждении. -->
  <key>StartCalendarInterval</key>
  <dict><key>Minute</key><integer>5</integer></dict>

  <key>StandardOutPath</key>
  <string>/Users/igor/igor-tp-reports-bot/tools/trainingpeaks-export/logs/fit-ingest-scan.launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/igor/igor-tp-reports-bot/tools/trainingpeaks-export/logs/fit-ingest-scan.launchd.err.log</string>
</dict>
</plist>
