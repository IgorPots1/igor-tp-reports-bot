<?xml version="1.0" encoding="UTF-8"?>
<!-- FIT-ingest scan + feedback-enqueue — считает derived_metrics ИЗ скачанного кэша
     и СРАЗУ САМ кладёт новые тренировки в «Новые» (enqueue на маке, ноль кронов Vercel).
     Идёт СЛЕДОМ за workout-cache-scan (КАЖДЫЕ 30 МИН на :15 и :45, cache-scan на :00/:30). Окно последних 5 дней. Кладётся в ~/Library/LaunchAgents/. Ставит Игорь:
       cp .../com.igor.trainingpeaks.fit-ingest-scan.plist ~/Library/LaunchAgents/
       launchctl load ~/Library/LaunchAgents/com.igor.trainingpeaks.fit-ingest-scan.plist -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.igor.trainingpeaks.fit-ingest-scan</string>

  <!-- CLUB_TRACKS_ENABLED=true: сохранять GPS-треки клуба. ВСЕГДА вместе с обрезкой приватности
       (CLUB_TRACK_PRIVACY_RADIUS_M, дефолт 300 м) — старт/финиш режутся в общем пути ингеста ДО
       записи в БД, чтобы домашний адрес не попал в базу. Тот же путь, что и 60-дневный бэкфилл. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>PAST_DAYS=5 CLUB_TRACKS_ENABLED=true CLUB_TRACK_PRIVACY_RADIUS_M=300 "$HOME/igor-tp-reports-bot/tools/trainingpeaks-export/scripts/run-fit-ingest-scan.sh"</string>
  </array>

  <!-- запуск при каждом входе/включении ноута (добирает пропущенное за время сна) -->
  <key>RunAtLoad</key>
  <true/>

  <!-- КАЖДЫЕ 30 МИН на :15 и :45 — на 15 мин ПОЗЖЕ cache-scan (:00/:30), чтобы тренировки уже были
       в кэше, когда считаем из них метрики (массив интервалов; Minute без Hour = каждый час на эту минуту).
       Было :05/:35 — аудит 11.10: cache-scan идёт до ~6 мин, и оба в конце запускают materialize
       по одним таблицам одновременно; на shared-CPU базы это и давало таймауты. Сдвиг на :15/:45
       разводит их с запасом. Пропущенные во сне прогоны launchd докручивает при пробуждении
       (против пачки сразу после пробуждения — задержка в runner-prelude.sh). -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Minute</key><integer>15</integer></dict>
    <dict><key>Minute</key><integer>45</integer></dict>
  </array>

  <key>StandardOutPath</key>
  <string>/Users/igor/igor-tp-reports-bot/tools/trainingpeaks-export/logs/fit-ingest-scan.launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/igor/igor-tp-reports-bot/tools/trainingpeaks-export/logs/fit-ingest-scan.launchd.err.log</string>
</dict>
</plist>
