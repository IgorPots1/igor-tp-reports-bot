<?xml version="1.0" encoding="UTF-8"?>
<!-- Еженедельный профиль-синк health-метрик (all-active): онбордит новых учеников в eligible-когорту. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.igor.trainingpeaks.custom-metrics-profile-sync</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>"$HOME/igor-tp-reports-bot/tools/trainingpeaks-export/scripts/run-custom-metrics-profile-sync-weekly.sh"</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>0</integer>
    <key>Hour</key><integer>9</integer>
    <key>Minute</key><integer>30</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/igor/igor-tp-reports-bot/tools/trainingpeaks-export/logs/custom-metrics-profile-sync.launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/igor/igor-tp-reports-bot/tools/trainingpeaks-export/logs/custom-metrics-profile-sync.launchd.err.log</string>
</dict>
</plist>
