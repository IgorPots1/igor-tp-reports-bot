# Copy this file to `worker.env` (same folder) and fill in both lines.
# worker.env is read by scripts/feedback_worker.py. Keep the secret private.

# Your app address + /api/feedback/worker  (the same site where the admin panel lives)
FEEDBACK_WORKER_URL=https://YOUR-APP.vercel.app/api/feedback/worker

# The SAME secret you saved in Vercel as FEEDBACK_WORKER_SECRET
FEEDBACK_WORKER_SECRET=paste-the-same-long-secret-here
